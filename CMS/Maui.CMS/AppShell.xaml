<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Maui.CMS.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maui.CMS"
    xmlns:views="clr-namespace:Maui.CMS.Views"
    Title="Maui.CMS">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    <ShellContent
        Title="Site Detail"
        ContentTemplate="{DataTemplate views:SiteDetailView}"
        Route="SiteDetail" />

</Shell>
